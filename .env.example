# Copy to .env for local development (or `vercel env pull .env`).
# The same variables must be set in Vercel (Production + Preview).

# --- Web Push (generate with: pnpm -s vapid) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Auth ---
# Random secret, at least 32 chars: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Optional locally (dev uses a fixed dev-only secret).
BETTER_AUTH_SECRET=
# Users who sign up with one of these emails become admins (comma-separated).
ADMIN_EMAILS=
# Set to "false" to close public sign-up.
SIGNUP_ENABLED=true
# Optional: public origin. On Vercel it is derived automatically.
# BETTER_AUTH_URL=https://my-veicolo.vercel.app

# --- Database ---
# Set by the Vercel Neon integration. Used in production and by `pnpm db:migrate`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# `pnpm dev` uses a local PGlite database (apps/api/.data) unless this is "neon".
# DEV_DATABASE=neon

# --- Plate lookups (paid API) ---
# Provider for "add vehicle by plate". Empty/"none" = data entered by hand (production default
# until a provider is chosen). "fake" = free fake data for dev (default in `pnpm dev`).
PLATE_PROVIDER=
# Max spend per calendar month in euro; lookups are refused above it. Default 5.
LOOKUP_MONTHLY_BUDGET_EUR=5
