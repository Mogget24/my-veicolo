    "web-push": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@my-veicolo/config": "workspace:*",
    "@my-veicolo/db": "workspace:*",
    "@my-veicolo/shared": "workspace:*",
    "@types/node": "catalog:",
    "@types/web-push": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
