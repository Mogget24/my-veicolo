  "devDependencies": {
    "@hono/node-server": "^2.1.8",
    "@my-veicolo/config": "workspace:*",
    "@my-veicolo/shared": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/web-push": "^3.6.4",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
