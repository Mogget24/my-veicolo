{
  "name": "@my-veicolo/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./dist/app.mjs"
    }
  },
  "scripts": {
