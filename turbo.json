{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["ADMIN_EMAILS", "SIGNUP_ENABLED", "DEV_DATABASE", "API_PORT", "BETTER_AUTH_*", "VAPID_*", "CRON_SECRET", "PLATE_PROVIDER", "LOOKUP_MONTHLY_BUDGET_EUR"]
    }
  }
}
